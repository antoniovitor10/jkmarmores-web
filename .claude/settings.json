      "Read(./*.pem)",
      "Read(./**/*.pem)",
      "Read(./*.key)",
      "Read(./**/*.key)",
      "Read(./*.p12)",
      "Read(./**/*.p12)",
      "Read(./*.pfx)",
      "Read(./**/*.pfx)",
      "Read(./*.jks)",
      "Read(./**/*.jks)",
      "Read(./*.keystore)",
      "Read(./**/*.keystore)",
      "Read(./id_rsa)",
      "Read(./**/id_rsa)",
      "Read(./id_ed25519)",
      "Read(./**/id_ed25519)",
      "Read(./tools/higgsfield/.env.local)"
    ]
  }
}
