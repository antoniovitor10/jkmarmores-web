const {chromium}=require('playwright');
(async()=>{const b=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe'});for(const mode of ['reduced','save-data']){const headers=mode==='save-data'?{'Save-Data':'on'}:{};const c=await b.newContext({viewport:{width:393,height:873},deviceScaleFactor:1,isMobile:true,hasTouch:true,reducedMotion:mode==='reduced'?'reduce':'no-preference',extraHTTPHeaders:headers});const p=await c.newPage();await p.goto('https://jkmarmores.com.br/',{waitUntil:'load',timeout:60000});await p.waitForTimeout(600);const o=await p.evaluate(mode=>({mode,motion:matchMedia('(prefers-reduced-motion: reduce)').matches,connectionSaveData:navigator.connection?.saveData??null,track:document.querySelector('[class*=track]')&&{motion:document.querySelector('[class*=track]').getAttribute('data-motion'),height:getComputedStyle(document.querySelector('[class*=track]')).height,transition:getComputedStyle(document.querySelector('[class*=track]')).transitionDuration},poster:[...document.images].find(x=>/poster/i.test(x.currentSrc))?.currentSrc,videos:document.querySelectorAll('video').length,fonts:document.fonts.status,resources:performance.getEntriesByType('resource').reduce((x,e)=>x+(e.transferSize||0),0),imgs:performance.getEntriesByType('resource').filter(e=>/avif|webp/.test(e.name)).map(e=>({url:e.name.split('/').slice(-1)[0],bytes:e.transferSize}))}),mode);console.log(JSON.stringify(o));await c.close()}await b.close()})();
